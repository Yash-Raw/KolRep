# Application Environment
APP_ENV=development
APP_SECRET_KEY=dev-secret-key-for-local-development-only-32chars
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# 100% Local Self-Hosted Voice Engine (F5-TTS DiT Flow Matching)
VOICE_PROVIDER=self_hosted
SELF_HOSTED_MODEL=F5TTS_v1_Base
SELF_HOSTED_DEVICE=auto
SELF_HOSTED_VOICE_DIR=./storage/voice_profiles
SELF_HOSTED_NFE_STEPS=32

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/voicerep
SYNC_DATABASE_URL=postgresql+psycopg2://postgres:postgrespassword@localhost:5432/voicerep

# Local Disk Storage (Default: ./storage)
LOCAL_STORAGE_PATH=./storage

# Redis & Background Workers
REDIS_URL=redis://localhost:6379/0

# Upload Limits
MAX_UPLOAD_SIZE_MB=50
MAX_AUDIO_DURATION_SECONDS=300

# (Optional) Supabase Auth - Leave blank for automatic local dev authentication
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWKS_URL=
SUPABASE_JWT_SECRET=
