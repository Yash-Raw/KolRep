# Application
APP_ENV=development
APP_SECRET_KEY=dev-secret-key-for-local-development-only-32chars
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/voicerep
SYNC_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/voicerep

# Supabase Auth
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_JWKS_URL=
SUPABASE_JWT_SECRET=

# ElevenLabs
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# Gemini - optional voice/sample analysis
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Storage - Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=voicerep-audio
R2_ENDPOINT_URL=
LOCAL_STORAGE_PATH=./storage

# Redis / Background Worker
REDIS_URL=redis://localhost:6379/0

# Upload Limits
MAX_UPLOAD_SIZE_MB=50
MAX_AUDIO_DURATION_SECONDS=300
